# 环境变量配置

# 应用基础配置
VITE_APP_NAME=IPTA
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# API配置
VITE_API_BASE=http://localhost:48080/app
VITE_API_TIMEOUT=10000
VITE_API_RETRY_COUNT=3
VITE_API_RETRY_DELAY=1000

# 后端真实数据配置（二选一）：
# 1. 转发到已有业务后端：APP_API_PROXY_TARGET=https://your-api-host
# 2. 直连 MySQL：DATABASE_URL=mysql://user:password@host:3306/database
#    或使用 DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD
# APP_API_PROXY_TARGET=
# DATABASE_URL=
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# 默认认证 SQL 使用 system_users，可按真实用户表覆盖：
# APP_AUTH_USER_SQL=SELECT id, username, nickname, password AS password_hash, email, tenant_id FROM system_users WHERE username = ? AND deleted = 0 LIMIT 1
# 教师分页默认读取 system_users + homework_classes；真实库字段不同可覆盖下列 SQL：
# APP_TEACHER_PAGE_COUNT_SQL=SELECT COUNT(DISTINCT u.id) AS n FROM system_users u LEFT JOIN homework_classes c ON c.teacher_id = u.id AND c.deleted = b'0' WHERE u.deleted = 0
# APP_TEACHER_PAGE_SQL=SELECT u.id AS id, u.id AS userId, u.id AS teacherId, u.username AS userName, COALESCE(u.nickname, u.username) AS teacherName, u.mobile AS phoneNumber, u.sex AS sex, u.status AS status, c.id AS classId, c.name AS className, c.grade AS gradeId, c.grade AS gradeName FROM system_users u LEFT JOIN homework_classes c ON c.teacher_id = u.id AND c.deleted = b'0' WHERE u.deleted = 0 ORDER BY u.id DESC LIMIT ?, ?

# Mock配置
VITE_USE_MOCK=false
VITE_MOCK_DELAY=500

# 认证配置
VITE_AUTH_TOKEN_KEY=ipta_token
VITE_AUTH_REFRESH_KEY=ipta_refresh_token
VITE_AUTH_REDIRECT_KEY=redirect_url

# 主题配置
VITE_THEME_STORAGE_KEY=ipta_theme
VITE_DEFAULT_THEME=light

# 国际化配置
VITE_I18N_STORAGE_KEY=ipta_locale
VITE_DEFAULT_LOCALE=zh-CN

# 缓存配置
VITE_CACHE_TTL=300000
VITE_CACHE_STORAGE_KEY=ipta_cache

# 日志配置
VITE_LOG_LEVEL=debug
VITE_LOG_STORAGE_KEY=ipta_logs

# 性能监控配置
VITE_ENABLE_PERFORMANCE_MONITOR=true
VITE_PERFORMANCE_THRESHOLD=1000

# 错误上报配置
VITE_ENABLE_ERROR_REPORT=true
VITE_ERROR_REPORT_URL=https://api.ipta.com/error-report

# 文件上传配置
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# 分页配置
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# 搜索配置
VITE_SEARCH_DEBOUNCE=300
VITE_SEARCH_MIN_LENGTH=2

# 通知配置
VITE_NOTIFICATION_DURATION=3000
VITE_MAX_NOTIFICATIONS=5

# WebSocket配置
VITE_WEBSOCKET_URL=ws://localhost:3000/ws
VITE_WEBSOCKET_RECONNECT_INTERVAL=5000
VITE_WEBSOCKET_MAX_RECONNECT_ATTEMPTS=5

# PWA配置
VITE_ENABLE_PWA=true
VITE_PWA_UPDATE_INTERVAL=86400000

# 分析配置
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ID=

# 功能开关
VITE_ENABLE_THEME_SWITCHER=true
VITE_ENABLE_LANGUAGE_SWITCHER=true
VITE_ENABLE_DENSITY_SWITCHER=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_REAL_TIME_FEATURES=true

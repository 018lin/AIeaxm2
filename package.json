    "@vueuse/core": "^14.0.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.13.1",
    "docx-preview": "^0.3.7",
    "echarts": "^6.0.0",
    "fabric": "^7.1.0",
    "html2canvas": "^1.4.1",
    "jsencrypt": "^3.3.2",
    "mysql2": "^3.24.4",

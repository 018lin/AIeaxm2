VITE_USE_MOCK=false
VITE_API_BASE=

# Local API server, not used by Vercel.
APP_API_PORT=48180

# Production database. Use a cloud MySQL-compatible database for Vercel.
# Example: mysql://user:password@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/test
DATABASE_URL=
DB_POOL_SIZE=1

# Enable TLS explicitly for cloud MySQL/TiDB. TiDB Cloud is auto-detected too.
DB_SSL=true

# Set a long random value in production.
APP_TOKEN_SECRET=

VITE_USE_MOCK=false
VITE_API_BASE=

# Local API server, not used by Vercel.
APP_API_PORT=48180

# Recommended real data mode: proxy every /api/v1/* request to the business backend.
APP_API_PROXY_TARGET=

# Direct-MySQL mode is only for explicit debugging when no business backend is available.
# Example: mysql://user:password@host:3306/database
DATABASE_URL=
DB_POOL_SIZE=1

# Enable TLS explicitly for cloud MySQL/TiDB. TiDB Cloud is auto-detected too.
DB_SSL=true

# Set a long random value in production.
APP_TOKEN_SECRET=
